# ─────────────────────────────────────────────
# SMTP Configuration — copy this to Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────

# Your Gmail address (the one that SENDS the notification)
SMTP_USER=your-gmail@gmail.com

# Gmail App Password (NOT your regular password)
# Steps to get it:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Then go to myaccount.google.com → Security → App Passwords
#   3. Select "Mail" + "Other (custom name)" → name it "Amro Site"
#   4. Copy the 16-character password here (no spaces)
SMTP_PASS=your-16-char-app-password

# The email where YOU want to RECEIVE enquiries (can be same or different)
CONTACT_RECEIVER=amro.saliem@gmail.com
